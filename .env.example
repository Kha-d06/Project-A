# Copy to .env and fill in. Never commit .env.

# Required. Generate each with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_SECRET_KEY=
POSTGRES_PASSWORD=
# Password for the restricted database role the scan worker uses.
WORKER_DB_PASSWORD=

# development | production. Production refuses to start with the default secret.
SENTINEL_ENVIRONMENT=development

# Public domain for Caddy, e.g. sentinel.example.org (TLS is automatic). Blank: http://localhost:8080
SENTINEL_SITE_ADDRESS=

# Set to true whenever the site is served over HTTPS (always, in production).
SENTINEL_SESSION_COOKIE_SECURE=false

# --- Optional providers. Leave blank to disable; scans will report them as unavailable. ---

# Free abuse.ch Auth-Key for live URLhaus lookups (https://auth.abuse.ch/).
# When set, submitted links are sent to abuse.ch. The downloaded feed works without a key.
SENTINEL_URLHAUS_AUTH_KEY=

# Hostname of a clamd service. With `docker compose --profile clamav`, use: clamav
SENTINEL_CLAMAV_HOST=

# Self-hosted MobSF for deeper APK analysis (uploaded apps go to this server only).
SENTINEL_MOBSF_URL=
SENTINEL_MOBSF_API_KEY=

# Optional AI explanations. Both are needed. Only verdicts and finding summaries are
# sent, and only when a user asks for an explanation.
SENTINEL_OPENAI_API_KEY=
SENTINEL_OPENAI_MODEL=

# Google Web Risk (Google Cloud API key with the Web Risk API enabled). Sends submitted links to Google.
SENTINEL_WEB_RISK_API_KEY=

# VirusTotal API key. Used only when the user ticks the consent box, and only the
# file's SHA-256 fingerprint is sent. The free tier allows 4 lookups a minute.
SENTINEL_VIRUSTOTAL_API_KEY=

# Isolated headless-browser rendering for website scans. Set both, then rebuild
# (docker compose build). The image grows by about 400 MB.
SENTINEL_WITH_BROWSER=false
SENTINEL_BROWSER_RENDERING=false

# Extra YARA rules (*.yar) to load alongside the built-in ones, as a container path.
SENTINEL_YARA_RULES_DIR=

# Email for verification and password reset. "smtp" needs the SMTP settings below.
SENTINEL_EMAIL_BACKEND=disabled
SENTINEL_EMAIL_FROM=SENTINEL <no-reply@your-domain.example>
SENTINEL_SMTP_HOST=
SENTINEL_SMTP_PORT=587
SENTINEL_SMTP_USERNAME=
SENTINEL_SMTP_PASSWORD=
# Public address of the site, used in links inside emails.
SENTINEL_PUBLIC_URL=http://localhost:8080

# Bearer token for /api/v1/system/metrics (used by the `monitoring` Compose profile).
# Leave blank to disable the metrics endpoint.
SENTINEL_METRICS_TOKEN=

# Where people can reach the operator of this instance (shown on the About page).
NEXT_PUBLIC_CONTACT_URL=
