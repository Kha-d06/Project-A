import { Button, Switch, LineEdit, ScrollView, AboutSlint, CheckBox } from "std-widgets.slint";
import { Theme } from "tokens.slint";
import { PostureRing } from "ring.slint";

export { Theme }

export struct CheckRow { id: string, label: string, status: string, status-text: string, freshness: string }
export struct ActionCard { id: string, title: string, detail: string, button: string, priority: int }
export struct ToggleRow { key: string, label: string, hint: string, on: bool, available: bool }
export struct PaletteItem { id: string, title: string }
export struct BrokerRow { id: string, title: string, detail: string, state: string, url: string, recheck: bool }
export struct CredRow { id: string, title: string, detail: string, state: string }
export struct SandboxRow { title: string, detail: string, url: string }
export struct BehRow { id: string, title: string, detail: string, state: string }
export struct ScanRow { path: string, title: string, detail: string, verdict: string, can-quarantine: bool, quarantined: bool }
export struct QuarRow { id: string, title: string, detail: string }
export struct DeepRow { title: string, detail: string }
export struct NetDevRow { key: string, ip: string, title: string, detail: string, badge: string, trusted: bool, can-check: bool }
export struct FindingRow { title: string, detail: string, severity: string }
export struct StartupRow { id: string, title: string, detail: string, is-new: bool, can-off: bool }
export struct LockRow { device: string, title: string, detail: string, blocked: bool, available: bool }
export struct PortRow { key: string, port: int, title: string, detail: string, fresh: bool, blocked: bool, exposed: bool }
export struct Labels {
    title: string, home: string, about: string, score: string, checks: string, actions: string,
    actions-none: string, dock: string, go: string, palette-placeholder: string, palette-hint: string,
    offline-title: string, offline-body: string, retry: string, busy: string, about-body: string,
    ports: string, ports-title: string, ports-intro: string, ports-none: string, ports-new: string,
    ports-blocked: string, ports-trust: string, ports-block: string, ports-unblock: string, ports-prompt: string,
    credentials: string, cred-title: string, cred-intro: string, cred-none: string, cred-suspend: string,
    cred-resume: string, cred-terminate: string, cred-allow: string, cred-dismiss: string,
    behaviour: string, beh-title: string, beh-intro: string, beh-none: string, beh-stop: string, beh-dismiss: string, beh-helper: string,
    sbx-title: string, sbx-intro: string, sbx-path: string, sbx-send: string, sbx-refresh: string, sbx-open: string,
    safepay: string, safepay-hint: string,
    brokers: string, brokers-title: string, brokers-intro: string, brokers-unreviewed: string, brokers-open: string,
    brokers-requested: string, brokers-removed: string, brokers-not-listed: string, brokers-copy: string,
    brokers-name: string, brokers-email: string,
    scan: string, scan-title: string, scan-intro: string, scan-quick: string, scan-path: string, scan-custom: string,
    scan-exclude: string, scan-exclusions: string, scan-include: string, scan-results: string, scan-inspect: string,
    scan-quarantine: string, scan-server: string, scan-close: string, scan-deep: string, scan-deep-intro: string,
    quarantine: string, quar-title: string, quar-intro: string, quar-none: string, quar-restore: string, quar-delete: string,
    protection: string, prot-title: string, prot-intro: string, prot-folders: string, prot-folder-path: string,
    prot-folder-add: string, prot-folder-remove: string, prot-halted: string, prot-halted-intro: string, prot-resume: string,
    prot-kill: string, prot-cfa-enable: string, prot-cfa-audit: string, prot-cfa-disable: string, prot-cfa-add: string,
    prot-cfa-allow: string, prot-cfa-hint: string, prot-system: string, prot-system-check: string,
    network: string, net-title: string, net-intro: string, net-scan: string, net-changes: string, net-devices: string,
    net-findings: string, net-no-findings: string, net-trust: string, net-untrust: string, net-consent: string, net-check: string,
    vpn: string, vpn-title: string, vpn-intro: string, vpn-connect: string, vpn-disconnect: string, vpn-split: string,
    vpn-split-full: string, vpn-split-exclude: string, vpn-split-only: string, vpn-range: string, vpn-range-add: string,
    vpn-trusted: string, vpn-trusted-name: string, vpn-trusted-add: string, vpn-remove: string,
    posture: string, pos-title: string, pos-intro: string, pos-check: string, pos-startup: string, pos-ack: string,
    pos-off: string, pos-on: string, pos-disabled: string, pos-integrity: string, pos-integrity-intro: string,
    pos-accept: string, pos-remove: string, pos-path: string, pos-add: string, pos-reset: string, pos-usb: string,
    privacy: string, priv-title: string, priv-intro: string, priv-block: string, priv-allow: string, priv-clipboard: string,
    priv-clear: string, priv-tools: string, priv-safepay: string, priv-alias: string, priv-brokers: string, priv-vault: string,
    priv-aliases-web: string,
    mail: string, mail-title: string, mail-intro: string, mail-app-password: string, mail-host: string, mail-port: string,
    mail-user: string, mail-password: string, mail-connect: string, mail-check: string, mail-disconnect: string,
}

component Card inherits Rectangle {
    background: Theme.elevated;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: Theme.radius;
}

component Heading inherits Text {
    font-size: 15px;
    font-weight: 600;
    color: Theme.ink;
    font-family: Theme.font;
    horizontal-alignment: Theme.rtl ? right : left;
    accessible-role: text;
}

component Muted inherits Text {
    font-size: 13px;
    color: Theme.muted;
    font-family: Theme.font;
    wrap: word-wrap;
    horizontal-alignment: Theme.rtl ? right : left;
}

component Dot inherits Rectangle {
    in property <string> status;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: Theme.status-color(status);
}

component CheckLine inherits Rectangle {
    in property <CheckRow> check;
    height: 44px;
    accessible-role: list-item;
    accessible-label: check.label + ": " + check.status-text + ", " + check.freshness;
    HorizontalLayout {
        spacing: 12px;
        padding-left: 4px;
        padding-right: 4px;
        alignment: stretch;
        if !Theme.rtl: Dot { status: check.status; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center;
            Text { text: check.label; color: Theme.ink; font-size: 14px; font-family: Theme.font; horizontal-alignment: Theme.rtl ? right : left; }
            Muted { text: check.status-text + " · " + check.freshness; }
        }
        if Theme.rtl: Dot { status: check.status; y: (parent.height - self.height) / 2; }
    }
}

/// The page list; the same rail sits on the left, or on the right in Arabic.
component NavRail inherits VerticalLayout {
    in property <Labels> labels;
    in property <string> palette-hint;
    in-out property <string> page;
    width: 180px;
    padding: 20px;
    spacing: 6px;
    Text { text: labels.title; font-size: 20px; font-weight: 600; color: Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
    Rectangle { height: 12px; }
    Button { text: labels.home; checkable: true; checked: page == "home"; clicked => { page = "home"; } }
    Button { text: labels.scan; checkable: true; checked: page == "scan"; clicked => { page = "scan"; } }
    Button { text: labels.quarantine; checkable: true; checked: page == "quarantine"; clicked => { page = "quarantine"; } }
    Button { text: labels.protection; checkable: true; checked: page == "protection"; clicked => { page = "protection"; } }
    Button { text: labels.posture; checkable: true; checked: page == "posture"; clicked => { page = "posture"; } }
    Button { text: labels.privacy; checkable: true; checked: page == "privacy"; clicked => { page = "privacy"; } }
    Button { text: labels.mail; checkable: true; checked: page == "mail"; clicked => { page = "mail"; } }
    Button { text: labels.network; checkable: true; checked: page == "network"; clicked => { page = "network"; } }
    Button { text: labels.vpn; checkable: true; checked: page == "vpn"; clicked => { page = "vpn"; } }
    Button { text: labels.ports; checkable: true; checked: page == "ports"; clicked => { page = "ports"; } }
    Button { text: labels.credentials; checkable: true; checked: page == "credentials"; clicked => { page = "credentials"; } }
    Button { text: labels.behaviour; checkable: true; checked: page == "behaviour"; clicked => { page = "behaviour"; } }
    Button { text: labels.brokers; checkable: true; checked: page == "brokers"; clicked => { page = "brokers"; } }
    Button { text: labels.about; checkable: true; checked: page == "about"; clicked => { page = "about"; } }
    Rectangle {}
    Text { text: palette-hint; font-size: 13px; color: Theme.muted; wrap: word-wrap; horizontal-alignment: Theme.rtl ? right : left; }
}

export component App inherits Window {
    title: labels.title;
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 520px;
    background: Theme.base;
    default-font-family: Theme.font;
    forward-focus: keys;

    in property <Labels> labels;
    in property <bool> rtl;
    in property <bool> connected: false;
    in property <bool> busy: false;
    in property <int> score;
    in property <string> state: "offline";
    in property <string> state-text;
    in property <string> notice;
    in property <[CheckRow]> checks;
    in property <[ActionCard]> actions;
    in property <[ToggleRow]> toggles;
    in property <[PortRow]> ports;
    in property <[ScanRow]> scan-rows;
    in property <string> scan-summary;
    in property <string> scan-engines;
    in property <string> scan-watched;
    in property <[string]> scan-exclusions;
    in property <bool> scanning: false;
    in-out property <string> scan-path;
    in-out property <string> inspector-text;
    in property <[DeepRow]> deep-rows;
    in property <[QuarRow]> quarantine-rows;
    in property <[ToggleRow]> prot-toggles;
    in property <[string]> prot-folders;
    in property <[QuarRow]> prot-halted;
    in property <[DeepRow]> prot-notes;
    in property <[DeepRow]> prot-system-rows;
    in property <bool> show-cfa: false;
    in-out property <string> prot-path;
    in property <string> net-summary;
    in property <[DeepRow]> net-change-rows;
    in property <[NetDevRow]> net-devices;
    in property <[FindingRow]> net-finding-rows;
    in property <bool> net-scanning: false;
    in-out property <bool> net-consent: false;
    in-out property <string> net-cred-text;
    in property <string> vpn-state-text;
    in property <string> vpn-hint;
    in property <bool> vpn-can-setup: false;
    in property <string> vpn-setup-label;
    in property <bool> vpn-can-connect: false;
    in property <bool> vpn-connected: false;
    in property <[ToggleRow]> vpn-toggles;
    in property <string> vpn-split-mode: "full";
    in property <string> vpn-split-hint;
    in property <[string]> vpn-ranges;
    in property <[string]> vpn-trusted-names;
    in-out property <string> vpn-range-input;
    in-out property <string> vpn-trusted-input;
    in property <string> pos-score-text;
    in property <[FindingRow]> pos-checks;
    in property <[StartupRow]> pos-startup;
    in property <bool> pos-any-new: false;
    in property <[QuarRow]> pos-disabled;
    in property <[string]> pos-paths;
    in property <[QuarRow]> pos-changes;
    in property <string> pos-usb-text;
    in property <bool> pos-checking: false;
    in-out property <string> pos-path-input;
    in property <[LockRow]> priv-locks;
    in property <string> priv-locks-note;
    in property <ToggleRow> priv-watch;
    in property <[DeepRow]> priv-uses;
    in property <string> priv-clip-text;
    in property <bool> priv-clip-armed: false;
    in property <string> priv-vault-url;
    in property <string> priv-aliases-url;
    in property <string> priv-web-note;
    in property <bool> mail-connected: false;
    in property <string> mail-account;
    in property <string> mail-summary;
    in property <string> mail-password-note;
    in property <ToggleRow> mail-watch;
    in property <[FindingRow]> mail-results;
    in property <bool> mail-checking: false;
    in-out property <string> mail-host-input;
    in-out property <string> mail-port-input: "993";
    in-out property <string> mail-user-input;
    in-out property <string> mail-password-input;
    in property <[CredRow]> credential-rows;
    in property <[BehRow]> behaviour-rows;
    in property <string> beh-note;
    in property <bool> beh-can-install: false;
    in property <[SandboxRow]> sandbox-rows;
    in-out property <string> sandbox-path;
    in property <[BrokerRow]> broker-rows;
    in property <string> broker-summary;
    in-out property <string> letter-name;
    in-out property <string> letter-email;
    in property <string> cred-mode;
    in property <bool> can-block: true;
    in property <string> clip-text;
    in property <string> clip-clear-label;
    in-out property <[PaletteItem]> palette-items;
    in-out property <bool> palette-open: false;
    in-out property <string> page: "home";

    callback run-action(string);
    callback set-toggle(string, bool);
    callback palette-filter(string);
    callback palette-run(string);
    callback retry();
    callback port-trust(string);
    callback clip-clear();
    // From the event thread: a secret was armed (kind, remaining ms) or cleared ("", 0).
    callback clip-event(string, int);
    callback port-block(int, bool);
    callback page-changed(string);
    callback cred-action(string, string);
    callback beh-action(string, string);
    callback beh-helper();
    callback sandbox-send(string);
    callback sandbox-refresh();
    callback sandbox-open(string);
    callback safepay();
    callback broker-open(string);
    callback broker-mark(string, string);
    callback broker-letter(string);
    callback scan-quick();
    callback scan-custom(string);
    callback scan-exclude(string);
    callback scan-include(string);
    callback scan-inspect(string);
    callback scan-quarantine(string);
    callback scan-server(string);
    callback scan-deep();
    callback quar-restore(string);
    callback quar-delete(string);
    callback prot-toggle(string, bool);
    callback prot-folder-add(string);
    callback prot-folder-remove(string);
    callback prot-halted-action(string, string);
    callback prot-cfa(string, string);
    callback prot-system();
    callback net-scan();
    callback net-trust(string, bool);
    callback net-check(string);
    callback vpn-setup();
    callback vpn-connect(bool);
    callback vpn-toggle(string, bool);
    callback vpn-split(string);
    callback vpn-range(string, bool);
    callback vpn-trust(string, bool);
    callback pos-check();
    callback pos-action(string, string);
    callback priv-action(string, string);
    callback mail-action(string);
    changed page => { page-changed(page); }

    changed rtl => { Theme.rtl = rtl; }
    init => { Theme.rtl = rtl; }

    public function close-palette() {
        palette-open = false;
        keys.focus();
    }

    public function open-palette() {
        palette-open = true;
        palette-filter("");
        query.text = "";
        query.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.meta) && (event.text == "k" || event.text == "K") {
                root.open-palette();
                return accept;
            }
            if event.text == Key.Escape && root.palette-open {
                root.close-palette();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            // Navigation rail (on the right in Arabic).
            if !rtl: NavRail { labels: root.labels; palette-hint: root.labels.palette-hint; page <=> root.page; }

            ScrollView {
                VerticalLayout {
                    padding: 28px;
                    spacing: Theme.gap;

                    if !connected: Card {
                        min-height: 160px;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.offline-title; font-size: 20px; }
                            Muted { text: labels.offline-body; }
                            HorizontalLayout {
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.retry; primary: true; clicked => { root.retry(); } }
                            }
                        }
                    }

                    if connected && clip-text != "": Rectangle {
                        background: Theme.elevated;
                        border-color: Theme.active;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        accessible-role: groupbox;
                        accessible-label: clip-text;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            Text {
                                text: clip-text;
                                color: Theme.ink;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                horizontal-alignment: Theme.rtl ? right : left;
                            }
                            Button {
                                horizontal-stretch: 0;
                                text: clip-clear-label;
                                accessible-label: clip-clear-label;
                                clicked => { root.clip-clear(); }
                            }
                        }
                    }

                    if connected && page == "home": VerticalLayout {
                        spacing: Theme.gap;

                        // Posture and checks.
                        Card {
                            HorizontalLayout {
                                padding: 24px;
                                spacing: 28px;
                                if !Theme.rtl: PostureRing { score: score; state: state; label: labels.score; }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: state-text;
                                        font-size: 26px;
                                        font-weight: 600;
                                        color: Theme.status-color(state);
                                        horizontal-alignment: Theme.rtl ? right : left;
                                        accessible-role: text;
                                        accessible-label: labels.score + ": " + state-text;
                                    }
                                    if notice != "": Muted { text: notice; }
                                    Rectangle { height: 8px; }
                                    Heading { text: labels.checks; }
                                    for item in checks: CheckLine { check: item; }
                                }
                                if Theme.rtl: PostureRing { score: score; state: state; label: labels.score; }
                            }
                        }

                        // Action queue.
                        Card {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Heading { text: labels.actions; }
                                if actions.length == 0: Muted { text: labels.actions-none; }
                                for card in actions: Rectangle {
                                    border-color: card.priority == 1 ? Theme.attention : Theme.line;
                                    border-width: 1px;
                                    border-radius: 8px;
                                    accessible-role: groupbox;
                                    accessible-label: card.title;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text { text: card.title; font-size: 14px; font-weight: 600; color: Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                                            Muted { text: card.detail; }
                                        }
                                        Button {
                                            horizontal-stretch: 0;
                                            min-width: 96px;
                                            text: card.button;
                                            enabled: !busy;
                                            accessible-label: card.title;
                                            clicked => { root.run-action(card.id); }
                                        }
                                    }
                                }
                            }
                        }

                        // Quick-toggle dock.
                        Card {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 8px;
                                Heading { text: labels.dock; }
                                HorizontalLayout {
                                    alignment: Theme.rtl ? end : start;
                                    Button {
                                        text: labels.safepay;
                                        accessible-label: labels.safepay;
                                        enabled: !busy;
                                        clicked => { root.safepay(); }
                                    }
                                }
                                Muted { text: labels.safepay-hint; font-size: 12px; }
                                for toggle in toggles: VerticalLayout {
                                    spacing: 0px;
                                    Switch {
                                        text: toggle.label;
                                        checked: toggle.on;
                                        enabled: toggle.available && !busy;
                                        accessible-label: toggle.label;
                                        toggled => { root.set-toggle(toggle.key, self.checked); }
                                    }
                                    if toggle.hint != "": Muted { text: toggle.hint; font-size: 12px; }
                                }
                            }
                        }
                    }

                    if connected && page == "ports": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.ports-title; font-size: 20px; }
                            Muted { text: labels.ports-intro; }
                            if ports.length == 0: Muted { text: labels.ports-none; }
                            for row in ports: Rectangle {
                                border-color: row.fresh ? Theme.attention : Theme.line;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title;
                                HorizontalLayout {
                                    padding: 12px;
                                    spacing: 10px;
                                    alignment: stretch;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: row.title + (row.fresh ? "  · " + labels.ports-new : "") + (row.blocked ? "  · " + labels.ports-blocked : "");
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: row.fresh ? Theme.attention : Theme.ink;
                                            horizontal-alignment: Theme.rtl ? right : left;
                                        }
                                        Muted { text: row.detail; }
                                    }
                                    if row.fresh: VerticalLayout { alignment: center; Button {
                                        horizontal-stretch: 0;
                                        vertical-stretch: 0;
                                        text: labels.ports-trust;
                                        accessible-label: labels.ports-trust + ": " + row.title;
                                        enabled: !busy;
                                        clicked => { root.port-trust(row.key); }
                                    } }
                                    if row.exposed && can-block: VerticalLayout { alignment: center; Button {
                                        horizontal-stretch: 0;
                                        vertical-stretch: 0;
                                        text: row.blocked ? labels.ports-unblock : labels.ports-block;
                                        accessible-label: (row.blocked ? labels.ports-unblock : labels.ports-block) + ": " + row.title;
                                        enabled: !busy;
                                        clicked => { root.port-block(row.port, !row.blocked); }
                                    } }
                                }
                            }
                            Muted { text: labels.ports-prompt; font-size: 12px; }
                        }
                    }

                    if connected && page == "credentials": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.cred-title; font-size: 20px; }
                            Muted { text: labels.cred-intro; }
                            Muted { text: cred-mode; font-size: 12px; }
                            if credential-rows.length == 0: Muted { text: labels.cred-none; }
                            for row in credential-rows: Rectangle {
                                border-color: row.state == "terminated" ? Theme.line : Theme.attention;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Text {
                                        text: row.title;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: row.state == "terminated" ? Theme.ink : Theme.attention;
                                        wrap: word-wrap;
                                        horizontal-alignment: Theme.rtl ? right : left;
                                    }
                                    Muted { text: row.detail; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: Theme.rtl ? end : start;
                                        if row.state == "open": Button {
                                            text: labels.cred-suspend;
                                            accessible-label: labels.cred-suspend + ": " + row.title;
                                            enabled: !busy;
                                            clicked => { root.cred-action(row.id, "suspend"); }
                                        }
                                        if row.state == "suspended": Button {
                                            text: labels.cred-resume;
                                            accessible-label: labels.cred-resume + ": " + row.title;
                                            enabled: !busy;
                                            clicked => { root.cred-action(row.id, "resume"); }
                                        }
                                        if row.state != "terminated": Button {
                                            text: labels.cred-terminate;
                                            accessible-label: labels.cred-terminate + ": " + row.title;
                                            enabled: !busy;
                                            clicked => { root.cred-action(row.id, "terminate"); }
                                        }
                                        Button {
                                            text: labels.cred-allow;
                                            accessible-label: labels.cred-allow + ": " + row.title;
                                            enabled: !busy;
                                            clicked => { root.cred-action(row.id, "allow"); }
                                        }
                                        Button {
                                            text: labels.cred-dismiss;
                                            accessible-label: labels.cred-dismiss + ": " + row.title;
                                            enabled: !busy;
                                            clicked => { root.cred-action(row.id, "dismiss"); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if connected && page == "behaviour": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.beh-title; font-size: 20px; }
                            Muted { text: labels.beh-intro; }
                            Muted { text: beh-note; font-size: 12px; }
                            if beh-can-install: HorizontalLayout {
                                alignment: Theme.rtl ? end : start;
                                Button {
                                    text: labels.beh-helper;
                                    enabled: !busy;
                                    clicked => { root.beh-helper(); }
                                }
                            }
                            if behaviour-rows.length == 0: Muted { text: labels.beh-none; }
                            for row in behaviour-rows: Rectangle {
                                border-color: row.state == "open" ? Theme.attention : Theme.line;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Text {
                                        text: row.title;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: row.state == "open" ? Theme.attention : Theme.ink;
                                        wrap: word-wrap;
                                        horizontal-alignment: Theme.rtl ? right : left;
                                    }
                                    Muted { text: row.detail; }
                                    if row.state == "open": HorizontalLayout {
                                        spacing: 8px;
                                        alignment: Theme.rtl ? end : start;
                                        Button {
                                            text: labels.beh-stop;
                                            accessible-label: labels.beh-stop + ": " + row.title;
                                            enabled: !busy;
                                            clicked => { root.beh-action(row.id, "stop"); }
                                        }
                                        Button {
                                            text: labels.beh-dismiss;
                                            accessible-label: labels.beh-dismiss + ": " + row.title;
                                            enabled: !busy;
                                            clicked => { root.beh-action(row.id, "dismiss"); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if connected && page == "behaviour": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.sbx-title; font-size: 18px; }
                            Muted { text: labels.sbx-intro; }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    placeholder-text: labels.sbx-path;
                                    accessible-label: labels.sbx-path;
                                    text <=> root.sandbox-path;
                                }
                                Button {
                                    text: labels.sbx-send;
                                    enabled: !busy && root.sandbox-path != "";
                                    clicked => { root.sandbox-send(root.sandbox-path); }
                                }
                                Button {
                                    text: labels.sbx-refresh;
                                    enabled: !busy;
                                    clicked => { root.sandbox-refresh(); }
                                }
                            }
                            for row in sandbox-rows: Rectangle {
                                border-color: Theme.line;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    Text { text: row.title; font-weight: 600; color: Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                                    Muted { text: row.detail; }
                                    HorizontalLayout {
                                        alignment: Theme.rtl ? end : start;
                                        Button {
                                            text: labels.sbx-open;
                                            accessible-label: labels.sbx-open + ": " + row.title;
                                            clicked => { root.sandbox-open(row.url); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if connected && page == "brokers": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 10px;
                            Heading { text: labels.brokers-title + "  ·  " + broker-summary; font-size: 20px; }
                            Muted { text: labels.brokers-intro; }
                            Muted { text: labels.brokers-unreviewed; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { placeholder-text: labels.brokers-name; accessible-label: labels.brokers-name; text <=> root.letter-name; }
                                LineEdit { placeholder-text: labels.brokers-email; accessible-label: labels.brokers-email; text <=> root.letter-email; input-type: text; }
                            }
                            for row in broker-rows: Rectangle {
                                border-color: row.recheck ? Theme.attention : Theme.line;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    Text { text: row.title; font-size: 14px; font-weight: 600; color: row.recheck ? Theme.attention : Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                                    Muted { text: row.detail; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: Theme.rtl ? end : start;
                                        Button { text: labels.brokers-open; accessible-label: labels.brokers-open + ": " + row.title; clicked => { root.broker-open(row.url); } }
                                        Button { text: labels.brokers-requested; accessible-label: labels.brokers-requested + ": " + row.title; enabled: !busy; clicked => { root.broker-mark(row.id, "requested"); } }
                                        Button { text: labels.brokers-removed; accessible-label: labels.brokers-removed + ": " + row.title; enabled: !busy; clicked => { root.broker-mark(row.id, "removed"); } }
                                        Button { text: labels.brokers-not-listed; accessible-label: labels.brokers-not-listed + ": " + row.title; enabled: !busy; clicked => { root.broker-mark(row.id, "not_listed"); } }
                                        Button { text: labels.brokers-copy; accessible-label: labels.brokers-copy + ": " + row.title; enabled: !busy && root.letter-name != "" && root.letter-email != ""; clicked => { root.broker-letter(row.id); } }
                                    }
                                }
                            }
                        }
                    }

                    if connected && page == "scan": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.scan-title; font-size: 20px; }
                            Muted { text: labels.scan-intro; }
                            Muted { text: scan-engines; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.scan-quick; primary: true; enabled: !busy && !scanning; clicked => { root.scan-quick(); } }
                                Button { text: labels.scan-deep; enabled: !busy && !scanning; clicked => { root.scan-deep(); } }
                            }
                            Muted { text: scan-watched; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { placeholder-text: labels.scan-path; accessible-label: labels.scan-path; text <=> root.scan-path; }
                                Button { text: labels.scan-custom; enabled: !busy && !scanning && root.scan-path != ""; clicked => { root.scan-custom(root.scan-path); } }
                                Button { text: labels.scan-exclude; enabled: !busy && root.scan-path != ""; clicked => { root.scan-exclude(root.scan-path); } }
                            }
                            Text {
                                text: scan-summary;
                                color: scanning ? Theme.active : Theme.ink;
                                horizontal-alignment: Theme.rtl ? right : left;
                                accessible-role: text;
                                accessible-label: scan-summary;
                            }
                            if scan-exclusions.length > 0: Muted { text: labels.scan-exclusions; font-size: 12px; }
                            for path in scan-exclusions: HorizontalLayout {
                                spacing: 8px;
                                Muted { text: path; vertical-alignment: center; }
                                Button { text: labels.scan-include; accessible-label: labels.scan-include + ": " + path; enabled: !busy; clicked => { root.scan-include(path); } }
                            }
                        }
                    }

                    // The file inspector: every finding for one file.
                    if connected && (page == "scan" || page == "quarantine") && inspector-text != "": Card {
                        border-color: Theme.active;
                        accessible-role: groupbox;
                        accessible-label: labels.scan-inspect;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            Heading { text: labels.scan-inspect; }
                            Text { text: inspector-text; color: Theme.ink; wrap: word-wrap; font-family: Theme.font; horizontal-alignment: Theme.rtl ? right : left; }
                            HorizontalLayout {
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.scan-close; clicked => { root.inspector-text = ""; } }
                            }
                        }
                    }

                    if connected && page == "scan" && deep-rows.length > 0: Card {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 8px;
                            Heading { text: labels.scan-deep; }
                            Muted { text: labels.scan-deep-intro; }
                            for row in deep-rows: VerticalLayout {
                                accessible-role: list-item;
                                accessible-label: row.title;
                                Text { text: row.title; color: Theme.ink; font-weight: 600; wrap: word-wrap; horizontal-alignment: Theme.rtl ? right : left; }
                                Muted { text: row.detail; }
                            }
                        }
                    }

                    if connected && page == "scan": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 10px;
                            Heading { text: labels.scan-results; }
                            for row in scan-rows: Rectangle {
                                border-color: row.verdict == "malicious" ? Theme.blocked : row.verdict == "suspicious" ? Theme.attention : Theme.line;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title + ": " + row.detail;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    Text { text: row.title; font-weight: 600; color: Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                                    Muted { text: row.detail; }
                                    Muted { text: row.path; font-size: 11px; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: Theme.rtl ? end : start;
                                        Button { text: labels.scan-inspect; accessible-label: labels.scan-inspect + ": " + row.title; clicked => { root.scan-inspect(row.path); } }
                                        if row.can-quarantine: Button { text: labels.scan-quarantine; accessible-label: labels.scan-quarantine + ": " + row.title; enabled: !busy; clicked => { root.scan-quarantine(row.path); } }
                                        if !row.quarantined: Button { text: labels.scan-server; accessible-label: labels.scan-server + ": " + row.title; enabled: !busy; clicked => { root.scan-server(row.path); } }
                                    }
                                }
                            }
                        }
                    }

                    if connected && page == "quarantine": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 10px;
                            Heading { text: labels.quar-title; font-size: 20px; }
                            Muted { text: labels.quar-intro; }
                            if quarantine-rows.length == 0: Muted { text: labels.quar-none; }
                            for row in quarantine-rows: Rectangle {
                                border-color: Theme.line;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    Text { text: row.title; font-weight: 600; color: Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                                    Muted { text: row.detail; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: Theme.rtl ? end : start;
                                        Button { text: labels.quar-restore; accessible-label: labels.quar-restore + ": " + row.title; enabled: !busy; clicked => { root.quar-restore(row.id); } }
                                        Button { text: labels.quar-delete; accessible-label: labels.quar-delete + ": " + row.title; enabled: !busy; clicked => { root.quar-delete(row.id); } }
                                    }
                                }
                            }
                        }
                    }

                    if connected && page == "protection": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.prot-title; font-size: 20px; }
                            Muted { text: labels.prot-intro; }
                            for toggle in prot-toggles: VerticalLayout {
                                spacing: 0px;
                                Switch {
                                    text: toggle.label;
                                    checked: toggle.on;
                                    enabled: toggle.available && !busy;
                                    accessible-label: toggle.label;
                                    toggled => { root.prot-toggle(toggle.key, self.checked); }
                                }
                                if toggle.hint != "": Muted { text: toggle.hint; font-size: 12px; }
                            }
                        }
                    }

                    // Frozen programs come first after the switches: they need a decision.
                    if connected && page == "protection" && prot-halted.length > 0: Card {
                        border-color: Theme.blocked;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            Heading { text: labels.prot-halted; color: Theme.blocked; }
                            Muted { text: labels.prot-halted-intro; }
                            for row in prot-halted: Rectangle {
                                border-color: Theme.blocked;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    Text { text: row.title; font-weight: 600; color: Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                                    Muted { text: row.detail; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: Theme.rtl ? end : start;
                                        Button { text: labels.prot-kill; primary: true; accessible-label: labels.prot-kill + ": " + row.title; enabled: !busy; clicked => { root.prot-halted-action(row.id, "kill"); } }
                                        Button { text: labels.prot-resume; accessible-label: labels.prot-resume + ": " + row.title; enabled: !busy; clicked => { root.prot-halted-action(row.id, "resume"); } }
                                    }
                                }
                            }
                        }
                    }

                    if connected && page == "protection": Card {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            Heading { text: labels.prot-folders; }
                            for note in prot-notes: VerticalLayout {
                                accessible-role: list-item;
                                accessible-label: note.title;
                                Text { text: note.title; color: Theme.ink; font-weight: 600; wrap: word-wrap; horizontal-alignment: Theme.rtl ? right : left; }
                                if note.detail != "": Muted { text: note.detail; }
                            }
                            for path in prot-folders: HorizontalLayout {
                                spacing: 8px;
                                Muted { text: path; vertical-alignment: center; }
                                Button { text: labels.prot-folder-remove; accessible-label: labels.prot-folder-remove + ": " + path; enabled: !busy; clicked => { root.prot-folder-remove(path); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { placeholder-text: labels.prot-folder-path; accessible-label: labels.prot-folder-path; text <=> root.prot-path; }
                                Button { text: labels.prot-folder-add; enabled: !busy && root.prot-path != ""; clicked => { root.prot-folder-add(root.prot-path); } }
                                if show-cfa: Button { text: labels.prot-cfa-add; enabled: !busy && root.prot-path != ""; clicked => { root.prot-cfa("add-folder", root.prot-path); } }
                                if show-cfa: Button { text: labels.prot-cfa-allow; enabled: !busy && root.prot-path != ""; clicked => { root.prot-cfa("allow-app", root.prot-path); } }
                            }
                            if show-cfa: HorizontalLayout {
                                spacing: 8px;
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.prot-cfa-enable; enabled: !busy; clicked => { root.prot-cfa("enable", ""); } }
                                Button { text: labels.prot-cfa-audit; enabled: !busy; clicked => { root.prot-cfa("audit", ""); } }
                                Button { text: labels.prot-cfa-disable; enabled: !busy; clicked => { root.prot-cfa("disable", ""); } }
                            }
                            if show-cfa: Muted { text: labels.prot-cfa-hint; font-size: 12px; }
                        }
                    }

                    if connected && page == "protection": Card {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            Heading { text: labels.prot-system; }
                            for row in prot-system-rows: VerticalLayout {
                                accessible-role: list-item;
                                accessible-label: row.title;
                                Text { text: row.title; color: Theme.ink; wrap: word-wrap; horizontal-alignment: Theme.rtl ? right : left; }
                                if row.detail != "": Muted { text: row.detail; font-size: 12px; }
                            }
                            HorizontalLayout {
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.prot-system-check; enabled: !busy; clicked => { root.prot-system(); } }
                            }
                        }
                    }

                    if connected && page == "network": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.net-title; font-size: 20px; }
                            Muted { text: labels.net-intro; }
                            Text {
                                text: net-summary;
                                color: net-scanning ? Theme.active : Theme.ink;
                                wrap: word-wrap;
                                horizontal-alignment: Theme.rtl ? right : left;
                                accessible-role: text;
                                accessible-label: net-summary;
                            }
                            HorizontalLayout {
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.net-scan; primary: true; enabled: !busy && !net-scanning; clicked => { root.net-scan(); } }
                            }
                            if net-change-rows.length > 0: Heading { text: labels.net-changes; }
                            for row in net-change-rows: VerticalLayout {
                                accessible-role: list-item;
                                accessible-label: row.title;
                                Text { text: row.title; color: Theme.ink; font-weight: 600; wrap: word-wrap; horizontal-alignment: Theme.rtl ? right : left; }
                                if row.detail != "": Muted { text: row.detail; }
                            }
                        }
                    }

                    if connected && page == "network" && net-devices.length > 0: Card {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            Heading { text: labels.net-findings; }
                            if net-finding-rows.length == 0: Muted { text: labels.net-no-findings; }
                            for row in net-finding-rows: VerticalLayout {
                                accessible-role: list-item;
                                accessible-label: row.title;
                                Text {
                                    text: row.title;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                    color: row.severity == "critical" || row.severity == "high" ? Theme.blocked : row.severity == "medium" ? Theme.attention : Theme.ink;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                }
                                if row.detail != "": Muted { text: row.detail; }
                            }
                        }
                    }

                    if connected && page == "network" && net-devices.length > 0: Card {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            Heading { text: labels.net-devices; }
                            CheckBox { text: labels.net-consent; checked <=> root.net-consent; accessible-label: labels.net-consent; }
                            if net-cred-text != "": Rectangle {
                                border-color: Theme.active;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: net-cred-text;
                                Text { x: 12px; width: parent.width - 24px; text: net-cred-text; color: Theme.ink; wrap: word-wrap; horizontal-alignment: Theme.rtl ? right : left; }
                                min-height: 40px;
                            }
                            for row in net-devices: Rectangle {
                                border-color: row.badge == "new" ? Theme.attention : Theme.line;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title + ": " + row.detail;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    Text { text: row.title; font-weight: 600; color: row.badge == "new" ? Theme.attention : Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                                    Muted { text: row.detail; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: Theme.rtl ? end : start;
                                        if row.badge != "router" && row.badge != "self": Button {
                                            text: row.trusted ? labels.net-untrust : labels.net-trust;
                                            accessible-label: (row.trusted ? labels.net-untrust : labels.net-trust) + ": " + row.title;
                                            enabled: !busy;
                                            clicked => { root.net-trust(row.key, !row.trusted); }
                                        }
                                        if row.can-check: Button {
                                            text: labels.net-check;
                                            accessible-label: labels.net-check + ": " + row.title;
                                            enabled: !busy && root.net-consent;
                                            clicked => { root.net-check(row.ip); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if connected && page == "vpn": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.vpn-title; font-size: 20px; }
                            Muted { text: labels.vpn-intro; }
                            Text {
                                text: vpn-state-text;
                                font-weight: 600;
                                color: vpn-connected ? Theme.protected : Theme.ink;
                                horizontal-alignment: Theme.rtl ? right : left;
                                accessible-role: text;
                                accessible-label: vpn-state-text;
                            }
                            if vpn-hint != "": Muted { text: vpn-hint; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: Theme.rtl ? end : start;
                                if vpn-can-connect: Button {
                                    text: vpn-connected ? labels.vpn-disconnect : labels.vpn-connect;
                                    primary: !vpn-connected;
                                    enabled: !busy;
                                    clicked => { root.vpn-connect(!vpn-connected); }
                                }
                                if vpn-can-setup: Button { text: vpn-setup-label; enabled: !busy; clicked => { root.vpn-setup(); } }
                            }
                            for toggle in vpn-toggles: VerticalLayout {
                                spacing: 0px;
                                Switch {
                                    text: toggle.label;
                                    checked: toggle.on;
                                    enabled: toggle.available && !busy;
                                    accessible-label: toggle.label;
                                    toggled => { root.vpn-toggle(toggle.key, self.checked); }
                                }
                                if toggle.hint != "": Muted { text: toggle.hint; font-size: 12px; }
                            }
                        }
                    }

                    if connected && page == "vpn": Card {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            Heading { text: labels.vpn-split; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.vpn-split-full; checkable: true; checked: vpn-split-mode == "full"; enabled: !busy; clicked => { root.vpn-split("full"); } }
                                Button { text: labels.vpn-split-exclude; checkable: true; checked: vpn-split-mode == "exclude"; enabled: !busy; clicked => { root.vpn-split("exclude"); } }
                                Button { text: labels.vpn-split-only; checkable: true; checked: vpn-split-mode == "only"; enabled: !busy; clicked => { root.vpn-split("only"); } }
                            }
                            Muted { text: vpn-split-hint; }
                            if vpn-split-mode != "full": VerticalLayout {
                                spacing: 6px;
                                for range in vpn-ranges: HorizontalLayout {
                                    spacing: 8px;
                                    Muted { text: range; vertical-alignment: center; }
                                    Button { text: labels.vpn-remove; accessible-label: labels.vpn-remove + ": " + range; enabled: !busy; clicked => { root.vpn-range(range, false); } }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { placeholder-text: labels.vpn-range; accessible-label: labels.vpn-range; text <=> root.vpn-range-input; }
                                    Button { text: labels.vpn-range-add; enabled: !busy && root.vpn-range-input != ""; clicked => { root.vpn-range(root.vpn-range-input, true); } }
                                }
                            }
                            Heading { text: labels.vpn-trusted; }
                            for name in vpn-trusted-names: HorizontalLayout {
                                spacing: 8px;
                                Muted { text: name; vertical-alignment: center; }
                                Button { text: labels.vpn-remove; accessible-label: labels.vpn-remove + ": " + name; enabled: !busy; clicked => { root.vpn-trust(name, false); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { placeholder-text: labels.vpn-trusted-name; accessible-label: labels.vpn-trusted-name; text <=> root.vpn-trusted-input; }
                                Button { text: labels.vpn-trusted-add; enabled: !busy && root.vpn-trusted-input != ""; clicked => { root.vpn-trust(root.vpn-trusted-input, true); } }
                            }
                        }
                    }

                    if connected && page == "posture": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.pos-title; font-size: 20px; }
                            Muted { text: labels.pos-intro; }
                            Text { text: pos-score-text; font-size: 16px; font-weight: 600; color: Theme.ink; horizontal-alignment: Theme.rtl ? right : left; accessible-role: text; accessible-label: pos-score-text; }
                            HorizontalLayout {
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.pos-check; primary: true; enabled: !busy && !pos-checking; clicked => { root.pos-check(); } }
                            }
                            for row in pos-checks: VerticalLayout {
                                accessible-role: list-item;
                                accessible-label: row.title;
                                Text {
                                    text: row.title;
                                    wrap: word-wrap;
                                    font-weight: 600;
                                    color: row.severity == "fail" ? Theme.blocked : row.severity == "warn" ? Theme.attention : row.severity == "pass" ? Theme.protected : Theme.muted;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                }
                                if row.detail != "": Muted { text: row.detail; }
                            }
                            Muted { text: labels.pos-usb + ": " + pos-usb-text; }
                        }
                    }

                    if connected && page == "posture": Card {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            Heading { text: labels.pos-startup; }
                            for row in pos-startup: Rectangle {
                                border-color: row.is-new ? Theme.attention : Theme.line;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title + ": " + row.detail;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    Text { text: row.title; font-weight: 600; color: row.is-new ? Theme.attention : Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                                    Muted { text: row.detail; }
                                    if row.can-off: HorizontalLayout {
                                        alignment: Theme.rtl ? end : start;
                                        Button { text: labels.pos-off; accessible-label: labels.pos-off + ": " + row.title; enabled: !busy; clicked => { root.pos-action("startup_off", row.id); } }
                                    }
                                }
                            }
                            if pos-any-new: HorizontalLayout {
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.pos-ack; enabled: !busy; clicked => { root.pos-action("startup_ack", ""); } }
                            }
                            if pos-disabled.length > 0: Heading { text: labels.pos-disabled; }
                            for row in pos-disabled: HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    Text { text: row.title; color: Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                                    Muted { text: row.detail; }
                                }
                                Button { text: labels.pos-on; accessible-label: labels.pos-on + ": " + row.title; enabled: !busy; clicked => { root.pos-action("startup_on", row.id); } }
                            }
                        }
                    }

                    if connected && page == "posture": Card {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            Heading { text: labels.pos-integrity; }
                            Muted { text: labels.pos-integrity-intro; }
                            for row in pos-changes: Rectangle {
                                border-color: Theme.blocked;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title;
                                HorizontalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        Text { text: row.title; color: Theme.blocked; font-weight: 600; wrap: word-wrap; horizontal-alignment: Theme.rtl ? right : left; }
                                        Muted { text: row.detail; }
                                    }
                                    Button { text: labels.pos-accept; accessible-label: labels.pos-accept + ": " + row.id; enabled: !busy; clicked => { root.pos-action("integrity_accept", row.id); } }
                                }
                            }
                            for path in pos-paths: HorizontalLayout {
                                spacing: 8px;
                                Muted { text: path; vertical-alignment: center; }
                                Button { text: labels.pos-remove; accessible-label: labels.pos-remove + ": " + path; enabled: !busy; clicked => { root.pos-action("integrity_remove", path); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { placeholder-text: labels.pos-path; accessible-label: labels.pos-path; text <=> root.pos-path-input; }
                                Button { text: labels.pos-add; enabled: !busy && root.pos-path-input != ""; clicked => { root.pos-action("integrity_add", root.pos-path-input); } }
                            }
                            HorizontalLayout {
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.pos-reset; enabled: !busy; clicked => { root.pos-action("integrity_reset", ""); } }
                            }
                        }
                    }

                    if connected && page == "privacy": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.priv-title; font-size: 20px; }
                            Muted { text: labels.priv-intro; }
                            for lock in priv-locks: HorizontalLayout {
                                spacing: 10px;
                                accessible-role: groupbox;
                                accessible-label: lock.title + ": " + lock.detail;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text { text: lock.title; font-weight: 600; color: Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                                    Muted { text: lock.detail; }
                                }
                                Button {
                                    text: lock.blocked ? labels.priv-allow : labels.priv-block;
                                    accessible-label: (lock.blocked ? labels.priv-allow : labels.priv-block) + ": " + lock.title;
                                    enabled: lock.available && !busy;
                                    clicked => { root.priv-action("lock:" + lock.device, lock.blocked ? "false" : "true"); }
                                }
                            }
                            Muted { text: priv-locks-note; font-size: 12px; }
                            VerticalLayout {
                                spacing: 0px;
                                Switch {
                                    text: priv-watch.label;
                                    checked: priv-watch.on;
                                    enabled: priv-watch.available && !busy;
                                    accessible-label: priv-watch.label;
                                    toggled => { root.priv-action("watch", self.checked ? "true" : "false"); }
                                }
                                Muted { text: priv-watch.hint; font-size: 12px; }
                            }
                            for use in priv-uses: VerticalLayout {
                                accessible-role: list-item;
                                accessible-label: use.title;
                                Text { text: use.title; color: use.detail == "" ? Theme.attention : Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                                if use.detail != "": Muted { text: use.detail; font-size: 12px; }
                            }
                        }
                    }

                    if connected && page == "privacy": Card {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            Heading { text: labels.priv-clipboard; }
                            Text { text: priv-clip-text; color: priv-clip-armed ? Theme.active : Theme.ink; wrap: word-wrap; horizontal-alignment: Theme.rtl ? right : left; accessible-role: text; accessible-label: priv-clip-text; }
                            if priv-clip-armed: HorizontalLayout {
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.priv-clear; enabled: !busy; clicked => { root.priv-action("clear", ""); } }
                            }
                            Heading { text: labels.priv-tools; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.priv-safepay; enabled: !busy; clicked => { root.priv-action("safepay", ""); } }
                                Button { text: labels.priv-alias; enabled: !busy; clicked => { root.priv-action("alias", ""); } }
                                Button { text: labels.priv-brokers; clicked => { root.priv-action("brokers", ""); } }
                            }
                            if priv-vault-url != "": HorizontalLayout {
                                spacing: 8px;
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.priv-vault; clicked => { root.priv-action("open", priv-vault-url); } }
                                Button { text: labels.priv-aliases-web; clicked => { root.priv-action("open", priv-aliases-url); } }
                            }
                            if priv-web-note != "": Muted { text: priv-web-note; font-size: 12px; }
                        }
                    }

                    if connected && page == "mail": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Heading { text: labels.mail-title; font-size: 20px; }
                            Muted { text: labels.mail-intro; }
                            if mail-account != "": Text { text: mail-account; font-weight: 600; color: Theme.ink; horizontal-alignment: Theme.rtl ? right : left; }
                            Text { text: mail-summary; color: mail-checking ? Theme.active : Theme.ink; wrap: word-wrap; horizontal-alignment: Theme.rtl ? right : left; accessible-role: text; accessible-label: mail-summary; }
                            if mail-password-note != "": Muted { text: mail-password-note; }
                            // Connecting, or entering the password again after a restart.
                            if !mail-connected || mail-password-note != "": VerticalLayout {
                                spacing: 8px;
                                Muted { text: labels.mail-app-password; font-size: 12px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { placeholder-text: labels.mail-host; accessible-label: labels.mail-host; text <=> root.mail-host-input; }
                                    LineEdit { width: 90px; placeholder-text: labels.mail-port; accessible-label: labels.mail-port; text <=> root.mail-port-input; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { placeholder-text: labels.mail-user; accessible-label: labels.mail-user; text <=> root.mail-user-input; }
                                    LineEdit { placeholder-text: labels.mail-password; accessible-label: labels.mail-password; input-type: password; text <=> root.mail-password-input; }
                                }
                                HorizontalLayout {
                                    alignment: Theme.rtl ? end : start;
                                    Button {
                                        text: labels.mail-connect;
                                        primary: true;
                                        enabled: !busy && !mail-checking && root.mail-host-input != "" && root.mail-user-input != "" && root.mail-password-input != "";
                                        clicked => { root.mail-action("connect"); }
                                    }
                                }
                            }
                            if mail-connected: HorizontalLayout {
                                spacing: 8px;
                                alignment: Theme.rtl ? end : start;
                                Button { text: labels.mail-check; enabled: !busy && !mail-checking; clicked => { root.mail-action("check"); } }
                                Button { text: labels.mail-disconnect; enabled: !busy; clicked => { root.mail-action("disconnect"); } }
                            }
                            if mail-connected: Switch {
                                text: mail-watch.label;
                                checked: mail-watch.on;
                                enabled: mail-watch.available && !busy;
                                accessible-label: mail-watch.label;
                                toggled => { root.mail-action(self.checked ? "watch-on" : "watch-off"); }
                            }
                        }
                    }

                    if connected && page == "mail" && mail-results.length > 0: Card {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 8px;
                            for row in mail-results: Rectangle {
                                border-color: row.severity == "known_malicious" ? Theme.blocked : row.severity == "suspicious" ? Theme.attention : Theme.line;
                                border-width: 1px;
                                border-radius: 8px;
                                accessible-role: groupbox;
                                accessible-label: row.title + ": " + row.detail;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 4px;
                                    Text { text: row.title; font-weight: 600; color: Theme.ink; wrap: word-wrap; horizontal-alignment: Theme.rtl ? right : left; }
                                    Muted { text: row.detail; }
                                }
                            }
                        }
                    }

                    if connected && page == "about": Card {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 14px;
                            Heading { text: labels.about; font-size: 20px; }
                            Muted { text: labels.about-body; }
                            // Required by Slint's royalty-free licence.
                            AboutSlint { }
                        }
                    }
                }
            }

            if rtl: NavRail { labels: root.labels; palette-hint: root.labels.palette-hint; page <=> root.page; }
        }
    }

    // Command palette (Ctrl/Cmd+K).
    Rectangle {
        visible: palette-open;
        background: #00000066;
        TouchArea { clicked => { root.close-palette(); } }
        Card {
            x: (parent.width - self.width) / 2;
            y: 80px;
            width: min(560px, parent.width - 40px);
            height: list.preferred-height + 80px;
            accessible-role: groupbox;
            accessible-label: labels.palette-placeholder;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                query := LineEdit {
                    placeholder-text: labels.palette-placeholder;
                    accessible-label: labels.palette-placeholder;
                    edited(text) => { root.palette-filter(text); }
                    accepted => {
                        if palette-items.length > 0 { root.palette-run(palette-items[0].id); root.close-palette(); }
                    }
                }
                list := VerticalLayout {
                    for item in palette-items: Rectangle {
                        height: 34px;
                        border-radius: 6px;
                        background: area.has-hover ? Theme.line : transparent;
                        accessible-role: button;
                        accessible-label: item.title;
                        accessible-action-default => { root.palette-run(item.id); root.close-palette(); }
                        area := TouchArea { clicked => { root.palette-run(item.id); root.close-palette(); } }
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: item.title;
                            color: Theme.ink;
                            vertical-alignment: center;
                            horizontal-alignment: Theme.rtl ? right : left;
                        }
                    }
                }
            }
        }
    }
}
