{
  "name": "@sentinel/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Qalaa Protect browser extension",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "TARGET_BROWSER=firefox node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "SENTINEL_TEST_BUILD=1 SENTINEL_SERVER=http://localhost:8787 node scripts/build.mjs && node test/e2e-assistant.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
