# Public entry point. Set SENTINEL_SITE_ADDRESS to your domain (for example
# sentinel.example.org) and Caddy obtains and renews a TLS certificate for it.
# The default, :8080, serves plain HTTP for local use.
{$SENTINEL_SITE_ADDRESS::8080} {
	encode zstd gzip

	# With no trusted_proxies configured, Caddy discards any X-Forwarded-For sent by
	# the client and sets it to the real client address. The API's per-client rate
	# limits depend on this, so the web and API containers must only be reachable
	# through here.
	# Installers and update feeds for the desktop and Android apps, copied into
	# ./downloads by scripts/publish-downloads.sh. Served as static files; the
	# desktop app checks <site>/downloads/desktop/latest*.yml for updates.
	handle_path /downloads/* {
		root * /srv/downloads
		header Cache-Control "no-cache"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	reverse_proxy web:3000

	request_body {
		# APK uploads can be up to 100 MB; the API enforces per-type limits.
		max_size 110MB
	}
}
